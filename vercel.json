{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/pricing", "destination": "/software", "permanent": true },
    { "source": "/features", "destination": "/software", "permanent": true },
    { "source": "/benchmark", "destination": "/software", "permanent": true },
    { "source": "/investors", "destination": "/software", "permanent": true },
    { "source": "/valuation", "destination": "/software", "permanent": true },
    { "source": "/updates", "destination": "/blog", "permanent": true },
    { "source": "/sources", "destination": "/blog", "permanent": true },
    { "source": "/asher", "destination": "/", "permanent": true },
    { "source": "/asher-dashboard", "destination": "/dashboard", "permanent": true },
    { "source": "/auth", "destination": "/dashboard", "permanent": false },
    { "source": "/glossary", "destination": "/blog", "permanent": true },
    { "source": "/glossary/:slug", "destination": "/blog", "permanent": true },
    { "source": "/feature/:slug", "destination": "/software", "permanent": true },
    { "source": "/blog/comparison", "destination": "/software", "permanent": true },
    { "source": "/blog/paid-seat-free-door", "destination": "/blog", "permanent": true },
    { "source": "/blog/aureon-pricing-explained", "destination": "/blog", "permanent": true },
    { "source": "/blog/asherin-pricing-explained", "destination": "/blog", "permanent": true },
    { "source": "/blog/predictions/:slug", "destination": "/blog", "permanent": true },
    { "source": "/security.txt", "destination": "/.well-known/security.txt", "permanent": true }
  ],
  "rewrites": [
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/dashboard/:path*", "destination": "/index.html" },
    { "source": "/whiteboard", "destination": "/index.html" },
    { "source": "/for/:slug", "destination": "/index.html" },
    { "source": "/asherin.acatalepsy", "destination": "/index.html" },
    { "source": "/asherin.analytics", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob: https://cdn.jsdelivr.net; worker-src 'self' blob: https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' data:; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; connect-src 'self' blob: data: https: wss: http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*; frame-src 'self' https://www.youtube-nocookie.com https://www.youtube.com https://player.vimeo.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self';"
        },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(self), usb=(), serial=(), midi=(), magnetometer=(self), gyroscope=(self), accelerometer=(self), interest-cohort=(), payment=()"
        },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
        { "key": "X-DNS-Prefetch-Control", "value": "off" },
        { "key": "X-Permitted-Cross-Domain-Policies", "value": "none" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(wallpapers|models|wasm|sentinel|fonts)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    },
    {
      "source": "/(dashboard|whiteboard|auth)(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(sw|aureon-killswitch-sw)\\.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/adam/:path*",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob: https://cdn.jsdelivr.net; worker-src 'self' blob: https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' data:; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; connect-src 'self' blob: data: https: wss: http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*; frame-src 'self' https://www.youtube-nocookie.com https://www.youtube.com https://player.vimeo.com; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self';"
        },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/adam/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/adam(/index\\.html)?",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
