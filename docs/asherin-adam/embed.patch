@@ -0,0 +1,43 @@
+/**
+ * Embedded profile: what the console keeps when it runs inside asherin as
+ * the room asherin.adam — a static bundle under /adam/ with no gateway
+ * behind it. Everything that needs /api/* is pruned at the entry point so
+ * no dead button remains; what stays is client-only (keyless imagery,
+ * terrain, USGS earthquakes, NASA recent imagery, bundled infrastructure).
+ */
+export const EMBED = import.meta.env.ADAM_EMBED === true;
+
+/** Data layers that reach their source without a server. */
+export const EMBED_LAYERS = new Set([
+  'earthquakes',
+  'recent-imagery',
+  'local-datacenters',
+  'local-dams',
+  'telegeography-submarine-cables',
+  'airspace-firs',
+]);
+
+/** Ops-rail chips that keep a purpose without live contacts or a server. */
+export const EMBED_RAIL = new Set(['intel', 'sky', 'maps', 'keys', 'settings']);
+
+/** Intel chips that stay (client-only panels). */
+export const EMBED_INTEL = new Set(['astro']);
+
+/** Whether a data layer may be shown or switched on in this build. */
+export function layerAllowed(id) {
+  return !EMBED || EMBED_LAYERS.has(String(id || ''));
+}
+
+/**
+ * A fetch for the application request services that never leaves the page:
+ * every call answers 503 at once, so the HUD, resolver and terrain helpers
+ * take their documented fallbacks instead of hitting a route that is not
+ * there. Scoped to those services — the page's own `fetch` stays native, so
+ * the tamper watch keeps its meaning.
+ */
+export async function offlineFetch() {
+  return new Response(JSON.stringify({ error: 'offline', configured: false }), {
+    status: 503,
+    headers: { 'Content-Type': 'application/json' },
+  });
+}
