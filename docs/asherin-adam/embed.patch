diff --git a/embed/vite.config.js b/embed/vite.config.js
new file mode 100644
index 0000000..a015889
--- /dev/null
+++ b/embed/vite.config.js
@@ -0,0 +1,31 @@
+import { defineConfig } from 'vite';
+import { createBrowserViteConfig } from '../build/vite.js';
+
+/**
+ * The embedded build: the globe console as a static bundle that asherin
+ * serves under /adam/ inside a same-origin iframe. No gateway exists there,
+ * so `import.meta.env.ADAM_EMBED` prunes every server-backed layer, panel
+ * and control at build time (see src/embed/profile.js). No keys are
+ * compiled in: imagery, terrain, earthquakes and recent imagery are keyless.
+ */
+export default defineConfig(({ command }) => {
+  const base = createBrowserViteConfig({ command });
+  return {
+    ...base,
+    plugins: [
+      ...base.plugins,
+      {
+        // The override sheet is the last stylesheet the entry imports, so its
+        // tokens win; the standalone build never loads it.
+        name: 'adam-embed-override-sheet',
+        transform(code, id) {
+          if (!id.endsWith('/src/main.js')) return null;
+          return `${code}\nimport './embed/asherin.css';\n`;
+        },
+      },
+    ],
+    base: '/adam/',
+    define: { ...base.define, 'import.meta.env.ADAM_EMBED': 'true' },
+    build: { ...base.build, outDir: 'dist-embed', emptyOutDir: true },
+  };
+});
diff --git a/src/embed/asherin.css b/src/embed/asherin.css
new file mode 100644
index 0000000..36bcf83
--- /dev/null
+++ b/src/embed/asherin.css
@@ -0,0 +1,197 @@
+/* ═══════════════════════════════════════════════
+   asherin.adam — the console inside asherin's interface.
+
+   Loaded last, after foundation.css, adam.css, adam-ops.css and modern.css,
+   so every token below wins. Dark monochrome glass, thin light type,
+   lowercase copy (modern.css keeps that rule). Colour is reserved for true
+   alert states: the alert and critical tiers keep their amber and red.
+   ═══════════════════════════════════════════════ */
+
+:root {
+  /* surfaces */
+  --bg-dark: #080808;
+  --ops-bg: #080808;
+  --ops-surface: #0f0f0f;
+  --menu-bg: #0f0f0f;
+  --glass-bg: rgba(255, 255, 255, 0.04);
+  --glass-bg-light: rgba(255, 255, 255, 0.04);
+  --glass-bg-dense: rgba(8, 8, 8, 0.84);
+  --glass-border: rgba(255, 255, 255, 0.1);
+  --glass-border-hover: rgba(255, 255, 255, 0.18);
+  --chrome-edge: rgba(255, 255, 255, 0.1);
+  --chrome-edge-glow: transparent;
+  --chrome-edge-highlight: transparent;
+
+  /* accent is the foreground at low alpha — tonal, never chromatic */
+  --accent: #ebebeb;
+  --accent-primary: #ebebeb;
+  --ops-accent: #ebebeb;
+  --accent-dim: rgba(255, 255, 255, 0.08);
+  --accent-primary-dim: rgba(255, 255, 255, 0.08);
+  --accent-glow: rgba(255, 255, 255, 0.14);
+  --ops-data-dim: rgba(235, 235, 235, 0.38);
+
+  /* type */
+  --text-primary: #ebebeb;
+  --ops-text: #ebebeb;
+  --text-secondary: rgba(235, 235, 235, 0.62);
+  --text-dim: rgba(235, 235, 235, 0.5);
+  --ops-text-dim: rgba(235, 235, 235, 0.5);
+  --weight-meta: 300;
+  --weight-value: 300;
+  --weight-readout: 300;
+
+  /* geometry */
+  --panel-radius: 14px;
+  --data-radius: 12px;
+  --btn-radius: 10px;
+  --chip-radius: 10px;
+}
+
+:root[data-gev-imagery='heavy'] {
+  --glass-bg: var(--glass-bg-dense);
+}
+
+html,
+body {
+  background: var(--bg-dark);
+  color: var(--text-primary);
+  font-weight: 300;
+}
+
+body,
+button,
+input,
+select,
+textarea,
+.adam-panel,
+.panel-collapsible {
+  font-weight: 300;
+}
+
+strong,
+b,
+h1,
+h2,
+h3,
+h4 {
+  font-weight: 300;
+}
+
+/* small caps labels: letter-spaced, quiet */
+.adam-meta,
+.adam-ops-rail-label,
+.adam-ops-kicker,
+.adam-ops-section,
+.panel-title,
+.pp-label,
+.pp-header-label,
+.indicator-label,
+.data-layer-group-heading,
+.location-toolbar-label,
+.map-source-heading,
+.cctv-summary-label,
+.panel-mini-label {
+  letter-spacing: 0.08em;
+  font-weight: 300;
+}
+
+/* glass panels: one surface, one hairline, no glow */
+.adam-panel,
+.panel-collapsible,
+#adam-ops-flyout,
+.adam-rail-menu,
+#style-indicator,
+#top-center-actions,
+#global-loading-status,
+#toast {
+  background: var(--glass-bg);
+  border: 1px solid var(--glass-border);
+  box-shadow: none;
+  backdrop-filter: blur(14px);
+  -webkit-backdrop-filter: blur(14px);
+}
+
+.panel-glow,
+.title-glow {
+  display: none !important;
+}
+
+/* loading cover */
+#loading-screen {
+  background: #080808;
+}
+#loading-screen h2 {
+  font-weight: 300;
+  letter-spacing: 0.02em;
+  color: var(--text-primary);
+  text-shadow: none;
+}
+#loading-screen .loader-status {
+  color: var(--text-dim);
+  font-weight: 300;
+}
+
+/* chips, buttons: tonal states */
+.adam-chip,
+.scene-btn,
+.pp-toggle-btn,
+.style-btn,
+.map-stack-chip {
+  font-weight: 300;
+  border-color: var(--glass-border);
+  box-shadow: none;
+}
+.adam-chip[aria-pressed='true'],
+.adam-chip.is-active,
+.adam-ops-rail-btn[aria-pressed='true'],
+.style-btn.active,
+.pp-toggle-btn.active,
+.map-stack-chip.active {
+  background: rgba(255, 255, 255, 0.12);
+  border-color: rgba(255, 255, 255, 0.26);
+  color: var(--text-primary);
+  box-shadow: none;
+}
+
+/* the surfaces this build has no server for stay out of the page */
+#cctv-panel,
+#scene-panel,
+#traffic-sync-chip,
+#cctv-sync-chip,
+#context-radio-dock,
+#gev-voice-control,
+.map-stack-chip.unavailable {
+  display: none !important;
+}
+
+/* focus rings stay visible, neutral */
+:focus-visible {
+  outline-color: var(--text-primary);
+}
+
+/* the cesium ion mark is attribution for ion-served data; nothing here is */
+body.adam-no-ion .cesium-credit-logoContainer {
+  display: none !important;
+}
+
+/* the room's header above the frame already names it: no second title */
+#title-bar {
+  display: none !important;
+}
+
+/* the viewfinder keeps its frame; the camcorder transport word goes */
+.adam-vf-text,
+.adam-vf-glyph {
+  display: none !important;
+}
+
+/* phone width: the action bar wraps instead of running off the frame */
+@media (max-width: 520px) {
+  #top-center-actions {
+    max-width: calc(100vw - 24px);
+    flex-wrap: wrap;
+    justify-content: center;
+    row-gap: 6px;
+  }
+}
