@@ -0,0 +1,27 @@
+import { normalizeRegionalWeather } from '../data/regionalModel.js';
+
+/**
+ * Current conditions straight from Open-Meteo (keyless, CORS-open) — the
+ * same request the gateway's /api/weather-effects makes on the console's
+ * behalf, shaped by the same normalizer, for the build with no gateway.
+ * The point is rounded to 0.01° (about a kilometre): conditions do not need
+ * more, and the request should not carry where the camera is to the metre.
+ */
+export async function fetchOpenMeteoWeather(
+  { latitude, longitude },
+  { fetchImpl = (...a) => fetch(...a), signal } = {},
+) {
+  const params = new URLSearchParams({
+    latitude: Number(latitude).toFixed(2),
+    longitude: Number(longitude).toFixed(2),
+    current:
+      'temperature_2m,apparent_temperature,precipitation,weather_code,cloud_cover,wind_speed_10m,wind_direction_10m,visibility',
+    timezone: 'UTC',
+  });
+  const res = await fetchImpl(
+    `https://api.open-meteo.com/v1/forecast?${params}`,
+    { signal },
+  );
+  if (!res.ok) throw new Error(`HTTP ${res.status}`);
+  return normalizeRegionalWeather(await res.json());
+}
